generator client {
  provider = "prisma-client-js"
  // Kalau lu pakai adapter-pg di file seed lu, wajib buka komen di bawah ini:
  previewFeatures = ["driverAdapters"] 
}

datasource db {
  provider = "postgresql"

}

model Mission {
  id          Int    @id @default(autoincrement())
  chapter     String
  title       String @unique
  slug        String @unique // Ditambahin biar sinkron sama data seed
  description String

  // Relasi Many-to-Many (Otomatis dibuatin tabel perantara sama Prisma)
  characters  Character[]
  locations   Location[]
}

model Character {
  id   Int    @id @default(autoincrement())
  name String @unique
  role String

  // Relasi Many-to-Many ke Mission
  missions Mission[]
}

model Location {
  id      Int    @id @default(autoincrement())
  name    String @unique
  chapter String

  // Relasi Many-to-Many ke Mission
  missions Mission[]
}